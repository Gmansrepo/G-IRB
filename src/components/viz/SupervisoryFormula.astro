---
/**
 * Interactive explorer for the IRB risk-weight function.
 * Renders its chart as an SVG string, so styles must be global
 * (Astro's scoped styles never reach innerHTML-injected nodes).
 */
import { CLASS_ORDER, CLASSES } from '../../lib/irb';
---

<figure class="sf-root bleed">
  <div class="sf-instrument">
    <aside class="sf-rail">
      <div class="card">
        <p class="sf-card-title">Exposure class</p>
        <div class="sf-classlist" id="sf-classlist">
          {CLASS_ORDER.map((k, i) => (
            <button type="button" data-key={k} aria-pressed={i === 0 ? 'true' : 'false'}>
              {CLASSES[k].label}
            </button>
          ))}
        </div>

        <div class="sf-ctl" id="sf-ctl-pd">
          <div class="sf-ctl-head">
            <label for="sf-pd">Probability of default</label>
            <span class="sf-val" id="sf-pd-val"></span>
          </div>
          <input type="range" id="sf-pd" min="0" max="1000" value="521" />
        </div>

        <div class="sf-ctl" id="sf-ctl-lgd">
          <div class="sf-ctl-head">
            <label for="sf-lgd">Loss given default</label>
            <span class="sf-val" id="sf-lgd-val"></span>
          </div>
          <input type="range" id="sf-lgd" min="1" max="100" value="45" />
        </div>

        <div class="sf-ctl" id="sf-ctl-m">
          <div class="sf-ctl-head">
            <label for="sf-m">Effective maturity</label>
            <span class="sf-val" id="sf-m-val"></span>
          </div>
          <input type="range" id="sf-m" min="1" max="5" step="0.1" value="2.5" />
          <span class="sf-note" id="sf-m-note"></span>
        </div>

        <div class="sf-ctl" id="sf-ctl-s" hidden>
          <div class="sf-ctl-head">
            <label for="sf-s">Annual turnover</label>
            <span class="sf-val" id="sf-s-val"></span>
          </div>
          <input type="range" id="sf-s" min="5" max="50" step="1" value="25" />
          <span class="sf-note">Firm-size adjustment, &euro;5m&ndash;&euro;50m</span>
        </div>

        <label class="sf-toggle">
          <input type="checkbox" id="sf-compare" /> Overlay other exposure classes
        </label>
      </div>

      <div class="card">
        <p class="sf-card-title">Asset correlation &nbsp;R(PD)</p>
        <svg id="sf-rchart" viewBox="0 0 256 132" role="img"
             aria-label="Asset correlation as a function of probability of default"></svg>
      </div>
    </aside>

    <div>
      <div class="card">
        <div class="sf-chart-head">
          <h3>Risk weight against PD</h3>
          <div class="sf-legend">
            <span><i class="sf-swatch" style="background:var(--accent)"></i> selected</span>
            <span id="sf-lg-ghost" hidden>
              <i class="sf-swatch" style="background:var(--ink-3);opacity:.5"></i> other classes
            </span>
          </div>
        </div>
        <svg id="sf-chart" viewBox="0 0 760 396" role="img"
             aria-label="Risk weight as a function of probability of default"></svg>
      </div>

      <dl class="sf-stats">
        <div class="sf-stat"><dt>Correlation R</dt><dd id="sf-s-r"></dd><small id="sf-s-r-sub"></small></div>
        <div class="sf-stat"><dt>Capital K</dt><dd id="sf-s-k"></dd><small>per unit of EAD</small></div>
        <div class="sf-stat sf-key"><dt>Risk weight</dt><dd id="sf-s-rw"></dd><small>12.5 &times; K</small></div>
        <div class="sf-stat"><dt>Own funds</dt><dd id="sf-s-cap"></dd><small>8% of RWA, &euro;10m EAD</small></div>
      </dl>
    </div>
  </div>

  <div class="sf-formula-block">
    <div class="eyebrow" style="margin-bottom:14px">The formula, with your inputs substituted</div>
    <div class="sf-formula">
      <b>K</b> &nbsp;=&nbsp; [ <span class="sf-t" id="sf-f-lgd">LGD</span> &middot; <b>N</b>(
      <span class="sf-t" id="sf-f-g">G(PD)</span> / &radic;<span class="sf-t" id="sf-f-1r">(1&minus;R)</span>
      &nbsp;+&nbsp; &radic;<span class="sf-t" id="sf-f-rr">(R/(1&minus;R))</span> &middot;
      <span class="sf-t" id="sf-f-q">G(0.999)</span> ) &nbsp;&minus;&nbsp;
      <span class="sf-t" id="sf-f-pdlgd">PD &middot; LGD</span> ] &nbsp;&middot;&nbsp;
      <span class="sf-t" id="sf-f-ma">MA</span>
    </div>
    <div class="sf-terms" id="sf-terms"></div>
  </div>

  <figcaption class="sf-cap">
    Move any input and the whole chain responds. Risk weight is 12.5 &times; K; the Basel&nbsp;II
    1.06 scaling factor is not applied. The dotted rule marks the 0.03% PD floor
    (CRR Art. 160(1), 163(1)). Illustrative &mdash; not a substitute for the regulation.
  </figcaption>
</figure>

<script>
  import { CLASSES, CLASS_ORDER, calc, inv, Q999 } from '../../lib/irb';

  const root = document.querySelector<HTMLElement>('.sf-root');
  if (root) {
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const PD_MIN = 0.0003, PD_MAX = 0.3;
    const state = { cls: 'corp', pd: 0.01, lgd: 0.45, m: 2.5, s: 25, compare: false };

    const pdFromSlider = (v: number) => PD_MIN * Math.pow(PD_MAX / PD_MIN, v / 1000);
    const sliderFromPd = (pd: number) => 1000 * Math.log(pd / PD_MIN) / Math.log(PD_MAX / PD_MIN);
    const pct = (x: number, d = 2) => (x * 100).toFixed(d) + '%';
    const pdText = (pd: number) => {
      const v = pd * 100;
      return (v < 0.1 ? v.toFixed(3) : v.toFixed(2)) + '%';
    };
    const tickText = (pd: number) => (pd * 100).toFixed(2).replace(/\.?0+$/, '') + '%';

    /* ---- geometry ---- */
    const W = 760, H = 396, M = { t: 16, r: 84, b: 44, l: 52 };
    const PW = W - M.l - M.r, PH = H - M.t - M.b;
    const lx = (pd: number) => M.l + PW * Math.log(pd / PD_MIN) / Math.log(PD_MAX / PD_MIN);

    function curvePath(key: string, lgd: number, m: number, s: number, ymax: number) {
      let d = '';
      const N = 170;
      for (let i = 0; i <= N; i++) {
        const pd = PD_MIN * Math.pow(PD_MAX / PD_MIN, i / N);
        const { rw } = calc(pd, lgd, m, key, s);
        const x = lx(pd), y = M.t + PH * (1 - Math.min(rw, ymax) / ymax);
        d += (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1);
      }
      return d;
    }

    function drawChart(cur: ReturnType<typeof calc>) {
      let ymax = 0;
      for (let i = 0; i <= 60; i++) {
        const pd = PD_MIN * Math.pow(PD_MAX / PD_MIN, i / 60);
        ymax = Math.max(ymax, calc(pd, state.lgd, state.m, state.cls, state.s).rw);
      }
      ymax = Math.max(1.5, Math.ceil(ymax / 0.5) * 0.5);

      let s = '';
      const yStep = ymax <= 2 ? 0.25 : 0.5;
      for (let v = 0; v <= ymax + 1e-9; v += yStep) {
        const y = M.t + PH * (1 - v / ymax);
        s += `<line class="${v === 0 ? 'sf-axis' : 'sf-grid'}" x1="${M.l}" y1="${y.toFixed(1)}" x2="${M.l + PW}" y2="${y.toFixed(1)}"/>`;
        s += `<text class="sf-tick" x="${M.l - 9}" y="${(y + 3.4).toFixed(1)}" text-anchor="end">${(v * 100).toFixed(0)}%</text>`;
      }
      [0.0003, 0.001, 0.003, 0.01, 0.03, 0.1, 0.3].forEach((pd) => {
        const x = lx(pd);
        s += `<line class="sf-grid" x1="${x.toFixed(1)}" y1="${M.t}" x2="${x.toFixed(1)}" y2="${M.t + PH}"/>`;
        s += `<text class="sf-tick" x="${x.toFixed(1)}" y="${M.t + PH + 17}" text-anchor="middle">${tickText(pd)}</text>`;
      });
      s += `<text class="sf-axis-title" x="${M.l}" y="${M.t + PH + 38}">PD &#8212; log scale</text>`;
      s += `<text class="sf-axis-title" x="${M.l}" y="${M.t - 4}">Risk weight</text>`;

      const xf = lx(0.0003);
      s += `<line x1="${xf.toFixed(1)}" y1="${M.t}" x2="${xf.toFixed(1)}" y2="${M.t + PH}" stroke="var(--ink-3)" stroke-width="1" stroke-dasharray="2 3" opacity=".7"/>`;

      if (state.compare) {
        CLASS_ORDER.forEach((k) => {
          if (k === state.cls) return;
          s += `<path class="sf-ghost" d="${curvePath(k, state.lgd, state.m, state.s, ymax)}"/>`;
          const endRw = calc(PD_MAX, state.lgd, state.m, k, state.s).rw;
          const ey = M.t + PH * (1 - Math.min(endRw, ymax) / ymax);
          s += `<text class="sf-ghost-label" x="${M.l + PW + 6}" y="${(ey + 3).toFixed(1)}">${CLASSES[k].short}</text>`;
        });
      }

      s += `<path class="sf-curve" d="${curvePath(state.cls, state.lgd, state.m, state.s, ymax)}"/>`;

      const cx = lx(state.pd), cy = M.t + PH * (1 - Math.min(cur.rw, ymax) / ymax);
      s += `<line x1="${cx.toFixed(1)}" y1="${cy.toFixed(1)}" x2="${cx.toFixed(1)}" y2="${M.t + PH}" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3" opacity=".55"/>`;
      s += `<line x1="${M.l}" y1="${cy.toFixed(1)}" x2="${cx.toFixed(1)}" y2="${cy.toFixed(1)}" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3" opacity=".55"/>`;
      s += `<circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="5" fill="var(--accent)" stroke="var(--surface)" stroke-width="2"/>`;

      const anchor = cx < M.l + 92 ? 'start' : 'end';
      const dx = anchor === 'end' ? -12 : 12;
      s += `<text x="${(cx + dx).toFixed(1)}" y="${(cy - 13).toFixed(1)}" text-anchor="${anchor}" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="500" fill="var(--accent)" stroke="var(--surface)" stroke-width="3.5" paint-order="stroke" stroke-linejoin="round">${(cur.rw * 100).toFixed(1)}%</text>`;

      $('sf-chart').innerHTML = s;
    }

    function drawR() {
      const w = 256, h = 132, m = { t: 12, r: 34, b: 24, l: 34 };
      const pw = w - m.l - m.r, ph = h - m.t - m.b;
      const X = (pd: number) => m.l + pw * Math.log(pd / PD_MIN) / Math.log(PD_MAX / PD_MIN);
      const Y = (r: number) => m.t + ph * (1 - r / 0.3);
      let s = '';
      [0, 0.12, 0.24, 0.3].forEach((v) => {
        s += `<line class="${v === 0 ? 'sf-axis' : 'sf-grid'}" x1="${m.l}" y1="${Y(v).toFixed(1)}" x2="${m.l + pw}" y2="${Y(v).toFixed(1)}"/>`;
        s += `<text class="sf-tick" x="${m.l - 6}" y="${(Y(v) + 3.2).toFixed(1)}" text-anchor="end">${v.toFixed(2)}</text>`;
      });
      let d = '';
      for (let i = 0; i <= 90; i++) {
        const pd = PD_MIN * Math.pow(PD_MAX / PD_MIN, i / 90);
        d += (i ? 'L' : 'M') + X(pd).toFixed(1) + ' ' + Y(CLASSES[state.cls].R(pd, state.s)).toFixed(1);
      }
      s += `<path d="${d}" fill="none" stroke="var(--teal)" stroke-width="2" stroke-linejoin="round"/>`;
      const R = CLASSES[state.cls].R(state.pd, state.s);
      s += `<circle cx="${X(state.pd).toFixed(1)}" cy="${Y(R).toFixed(1)}" r="4" fill="var(--teal)" stroke="var(--surface)" stroke-width="2"/>`;
      s += `<text class="sf-tick" x="${m.l}" y="${h - 6}">0.03%</text>`;
      s += `<text class="sf-tick" x="${m.l + pw}" y="${h - 6}" text-anchor="end">30%</text>`;
      $('sf-rchart').innerHTML = s;
    }

    const TERMS: [string, (c: ReturnType<typeof calc>) => string, string][] = [
      ['R', (c) => c.R.toFixed(4), 'Exposure to the single systematic factor.'],
      ['G(PD)', () => inv(state.pd).toFixed(4), 'PD restated as a standard-normal threshold.'],
      ['G(0.999)', () => Q999.toFixed(4), 'The supervisory confidence level. Fixed.'],
      ['N(·)', (c) => c.cond.toFixed(4), 'Default rate in the 1-in-1000 stress state.'],
      ['b', (c) => (CLASSES[state.cls].maturity ? c.b.toFixed(4) : '—'), 'Smoothing coefficient in the maturity term.'],
      ['MA', (c) => (CLASSES[state.cls].maturity ? c.ma.toFixed(4) : '1.0000'), 'Scales K for exposures longer than 2.5 years.'],
    ];

    function render() {
      const C = CLASSES[state.cls];
      const cur = calc(state.pd, state.lgd, state.m, state.cls, state.s);

      $('sf-pd-val').textContent = pdText(state.pd);
      $('sf-lgd-val').textContent = (state.lgd * 100).toFixed(0) + '%';
      $('sf-m-val').textContent = state.m.toFixed(1) + ' yr';
      $('sf-s-val').textContent = '€' + state.s + 'm';

      $('sf-ctl-m').classList.toggle('sf-off', !C.maturity);
      $('sf-m-note').textContent = C.maturity ? '' : 'No maturity adjustment for retail';
      $('sf-ctl-s').hidden = !C.sizeAdj;
      $('sf-lg-ghost').hidden = !state.compare;

      $('sf-s-r').textContent = cur.R.toFixed(4);
      $('sf-s-r-sub').textContent = C.maturity ? 'PD-dependent' : 'fixed by class';
      $('sf-s-k').textContent = pct(cur.k, 2);
      $('sf-s-rw').textContent = pct(cur.rw, 1);
      $('sf-s-cap').textContent = '€' + (10 * cur.rw * 0.08).toFixed(2) + 'm';

      $('sf-f-lgd').textContent = (state.lgd * 100).toFixed(0) + '%';
      $('sf-f-g').textContent = inv(state.pd).toFixed(3);
      $('sf-f-1r').textContent = (1 - cur.R).toFixed(3);
      $('sf-f-rr').textContent = (cur.R / (1 - cur.R)).toFixed(3);
      $('sf-f-q').textContent = Q999.toFixed(3);
      $('sf-f-pdlgd').textContent = (state.pd * state.lgd * 100).toFixed(3) + '%';
      $('sf-f-ma').textContent = cur.ma.toFixed(3);

      $('sf-terms').innerHTML = TERMS.map(
        (t) => `<div class="sf-term"><div class="sf-k">${t[0]}</div><div class="sf-v">${t[1](cur)}</div><div class="sf-d">${t[2]}</div></div>`
      ).join('');

      drawChart(cur);
      drawR();
    }

    Array.from($('sf-classlist').children).forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.key!;
        state.cls = key;
        state.lgd = CLASSES[key].lgd / 100;
        ($('sf-lgd') as HTMLInputElement).value = String(CLASSES[key].lgd);
        Array.from($('sf-classlist').children).forEach((b) =>
          b.setAttribute('aria-pressed', (b as HTMLElement).dataset.key === key ? 'true' : 'false')
        );
        render();
      });
    });

    $<HTMLInputElement>('sf-pd').addEventListener('input', function () { state.pd = pdFromSlider(+this.value); render(); });
    $<HTMLInputElement>('sf-lgd').addEventListener('input', function () { state.lgd = +this.value / 100; render(); });
    $<HTMLInputElement>('sf-m').addEventListener('input', function () { state.m = +this.value; render(); });
    $<HTMLInputElement>('sf-s').addEventListener('input', function () { state.s = +this.value; render(); });
    $<HTMLInputElement>('sf-compare').addEventListener('change', function () { state.compare = this.checked; render(); });

    ($('sf-pd') as HTMLInputElement).value = String(Math.round(sliderFromPd(state.pd)));
    render();
  }
</script>

<style is:global>
  .sf-root { margin: 34px 0; display: block; }
  .sf-instrument { display: grid; grid-template-columns: 296px minmax(0, 1fr); gap: 28px; align-items: start; }
  .sf-rail { display: flex; flex-direction: column; gap: 18px; }

  .sf-card-title { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .15em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 16px; }

  .sf-classlist { display: flex; flex-direction: column; gap: 1px; margin-bottom: 22px; }
  .sf-classlist button { font: inherit; font-size: 13.5px; text-align: left; cursor: pointer; background: transparent; color: var(--ink-2); border: 0; border-left: 2px solid var(--rule-2); padding: 7px 12px; transition: color .15s, border-color .15s, background .15s; }
  .sf-classlist button:hover { color: var(--ink); background: var(--surface-2); }
  .sf-classlist button[aria-pressed='true'] { color: var(--ink); border-left-color: var(--accent); font-weight: 500; background: var(--surface-2); }

  .sf-ctl { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
  .sf-ctl.sf-off { opacity: .38; pointer-events: none; }
  .sf-ctl-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .sf-ctl-head label { font-size: 13px; color: var(--ink-2); }
  .sf-val { font-family: var(--font-mono); font-size: 14px; font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 500; }
  .sf-note { font-size: 11.5px; color: var(--ink-3); font-style: italic; }

  .sf-root input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 18px; background: transparent; cursor: grab; margin: 0; }
  .sf-root input[type='range']:active { cursor: grabbing; }
  .sf-root input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--rule); }
  .sf-root input[type='range']::-moz-range-track { height: 2px; background: var(--rule); }
  .sf-root input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px; margin-top: -5.5px; border-radius: 50%; background: var(--accent); border: 2px solid var(--surface); }
  .sf-root input[type='range']::-moz-range-thumb { width: 13px; height: 13px; border-radius: 50%; background: var(--accent); border: 2px solid var(--surface); }

  .sf-toggle { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--ink-2); cursor: pointer; padding-top: 6px; border-top: 1px solid var(--rule-2); }
  .sf-toggle input { accent-color: var(--accent); width: 14px; height: 14px; cursor: pointer; }

  .sf-chart-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 6px; flex-wrap: wrap; }
  .sf-chart-head h3 { font-family: var(--font-display); font-weight: 400; font-size: 20px; margin: 0; }
  .sf-legend { display: flex; gap: 16px; font-size: 11.5px; color: var(--ink-2); font-family: var(--font-mono); }
  .sf-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .sf-swatch { width: 14px; height: 2px; display: inline-block; }

  .sf-root svg { display: block; width: 100%; height: auto; overflow: visible; }
  #sf-rchart { max-width: 280px; }
  .sf-tick { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-3); font-variant-numeric: tabular-nums; }
  .sf-axis-title { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-3); letter-spacing: .1em; text-transform: uppercase; }
  .sf-ghost-label { font-family: var(--font-mono); font-size: 9.5px; fill: var(--ink-3); }
  .sf-curve { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .sf-ghost { fill: none; stroke: var(--ink-3); stroke-width: 1; opacity: .4; }
  .sf-grid { stroke: var(--rule-2); stroke-width: 1; }
  .sf-axis { stroke: var(--rule); stroke-width: 1; }

  .sf-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; margin: 18px 0 0; }
  .sf-stat { background: var(--surface); padding: 14px 16px; display: flex; flex-direction: column; gap: 3px; }
  .sf-stat dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
  .sf-stat dd { margin: 0; font-family: var(--font-mono); font-size: 23px; font-weight: 500; font-variant-numeric: tabular-nums; letter-spacing: -.02em; line-height: 1.15; }
  .sf-stat.sf-key dd { color: var(--accent); }
  .sf-stat small { font-size: 11px; color: var(--ink-3); font-family: var(--font-body); }

  .sf-formula-block { margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--rule); }
  .sf-formula { font-family: var(--font-mono); font-size: clamp(13px, 1.65vw, 17px); line-height: 2.5; overflow-x: auto; padding: 8px 0 4px; white-space: nowrap; color: var(--ink-2); }
  .sf-formula b { font-weight: 500; color: var(--ink); }
  .sf-t { color: var(--ink); border-bottom: 1.5px solid var(--accent-soft); padding: 2px 1px; }
  .sf-terms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; margin-top: 22px; }
  .sf-term { background: var(--surface); padding: 13px 15px; }
  .sf-k { font-family: var(--font-mono); font-size: 12.5px; color: var(--accent); font-weight: 500; }
  .sf-v { font-family: var(--font-mono); font-size: 17px; font-variant-numeric: tabular-nums; color: var(--ink); margin-top: 1px; }
  .sf-d { font-size: 11.5px; color: var(--ink-3); line-height: 1.4; margin-top: 5px; }

  .sf-cap { margin: 22px 0 0; font-size: 12px; color: var(--ink-3); max-width: 78ch; line-height: 1.5; }

  @media (max-width: 900px) {
    .sf-instrument { grid-template-columns: 1fr; }
    .sf-rail .card { max-width: 520px; }
    .sf-stats, .sf-terms { grid-template-columns: repeat(2, 1fr); }
  }
</style>
