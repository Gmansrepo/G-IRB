---
import { url } from '../lib/url';

const links = [
  { href: url('topics'),      label: 'Topics' },
  { href: url('regulations'), label: 'Regulations' },
  { href: url('about'),       label: 'About' },
];

// Mark the active section by first path segment, base-prefixed or not.
const seg = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').split('/').filter(Boolean)[0] ?? '';
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="logo" href={url()}>G&#8209;IRB</a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.label.toLowerCase() === seg ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav { border-bottom: 1px solid var(--rule); background: var(--ground); }
  .nav-inner {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 24px; padding-block: 18px; flex-wrap: wrap;
  }
  .logo {
    font-family: var(--font-mono); font-size: 15px; font-weight: 500;
    letter-spacing: .12em; color: var(--ink); text-decoration: none;
  }
  .logo:hover { color: var(--accent); }
  nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  nav a {
    font-size: 14px; color: var(--ink-2); text-decoration: none;
    padding-bottom: 3px; border-bottom: 1.5px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
</style>
