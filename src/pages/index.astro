---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const topics = (await getCollection('topics', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const scope = [
  ['Estimation', 'PD, LGD and EAD — from data to a calibrated parameter'],
  ['Validation', 'Discriminatory power, calibration accuracy, stability'],
  ['Capital', 'The supervisory formula and what drives a risk weight'],
  ['Regulation', 'CRR and the EBA guidelines, read closely'],
];
---
<Base title="G-IRB">
  <div class="wrap hero">
    <div class="hero-text">
      <p class="eyebrow">A working knowledge base</p>
      <h1>Notes from inside the<br /><em>internal ratings&#8209;based</em> approach</h1>
      <p class="lede">
        Whether it is new guidelines, changes to the CRR, or best practice in machine
        learning methods, the IRB landscape keeps evolving at pace. This is where those
        changes get written down and worked through &mdash; slowly, and with the
        arithmetic left in.
      </p>
      <p class="links">
        <a href={url('topics')}>Read the topics</a>
        <span aria-hidden="true">&middot;</span>
        <a href={url('about')}>About this site</a>
      </p>
    </div>

    <aside class="scope">
      <p class="scope-title">What is covered</p>
      <dl>
        {scope.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
      </dl>
    </aside>
  </div>

  <div class="wrap">
    <section class="latest">
      <h2>Topics</h2>
      <ul class="topic-list">
        {topics.map((t) => (
          <li>
            <a href={url(`topics/${t.id}`)}>
              <span class="t-title">{t.data.title}</span>
              <span class="t-sum">{t.data.summary}</span>
              <time datetime={t.data.date.toISOString()}>
                {t.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })}
              </time>
            </a>
          </li>
        ))}
      </ul>
      {topics.length === 0 && <p class="empty">No topics published yet.</p>}
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) 268px;
    gap: 48px; align-items: start;
    padding-block: 56px 48px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-text { display: flex; flex-direction: column; gap: 18px; }
  h1 em { font-style: italic; color: var(--accent); }
  .lede { max-width: 58ch; color: var(--ink-2); font-size: 16.5px; }
  .links { display: flex; gap: 10px; align-items: baseline; font-size: 14px; }

  .scope { border-left: 1px solid var(--rule); padding-left: 22px; }
  .scope-title {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 14px;
  }
  .scope dl { margin: 0; display: grid; gap: 2px; }
  .scope dt {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--ink);
    margin-top: 12px; letter-spacing: .02em;
  }
  .scope dt:first-of-type { margin-top: 0; }
  .scope dd { margin: 0; color: var(--ink-2); font-size: 12.5px; line-height: 1.45; }

  .latest { padding-block: 44px 64px; }
  .latest h2 { font-size: var(--step-2); margin-bottom: 20px; }
  .topic-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .topic-list li { border-top: 1px solid var(--rule); }
  .topic-list li:last-child { border-bottom: 1px solid var(--rule); }
  .topic-list a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 24px;
    padding: 18px 4px; text-decoration: none; color: inherit; align-items: baseline;
  }
  .topic-list a:hover .t-title { color: var(--accent); }
  .t-title { font-family: var(--font-display); font-size: var(--step-1); }
  .t-sum { grid-column: 1; color: var(--ink-2); font-size: 13.5px; max-width: 62ch; }
  .topic-list time { grid-row: 1; grid-column: 2; font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-3); }
  .empty { color: var(--ink-3); font-size: 14px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding-block: 36px 32px; }
    .scope { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 20px; }
    .topic-list a { grid-template-columns: 1fr; }
    .topic-list time { grid-row: auto; grid-column: 1; }
  }
</style>
