---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const topics = await getCollection('topics', ({ data }) => !data.draft);
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="wrap post">
    <header class="head">
      <p class="eyebrow">
        <a href={url('topics')}>Topics</a>
        {entry.data.tags.length > 0 && <> &middot; {entry.data.tags.join(' · ')}</>}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <p class="meta">
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {entry.data.updated && (
          <> &middot; updated {entry.data.updated.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</>
        )}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { padding-block: 44px 76px; }
  .head { display: flex; flex-direction: column; gap: 13px; padding-bottom: 30px; border-bottom: 1px solid var(--rule); margin-bottom: 36px; }
  .head .eyebrow a { color: var(--ink-3); text-decoration: none; }
  .head .eyebrow a:hover { color: var(--accent); }
  .lede { max-width: 60ch; color: var(--ink-2); font-size: 17px; }
  .meta { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-3); }
</style>
